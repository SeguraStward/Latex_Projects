% =============================================================================
%  REFERENCIAS — formato APA (biblatex-apa + biber)
%  -------------------------------------------------------------------------
%  Agrega aquí tus fuentes confiables (libros, artículos, informes, lecturas
%  del curso). Cítalas con:  \parencite{clave}  ó  \textcite{clave}
%
%  Plantillas de ejemplo (descomentar y completar):
%
% @book{apellido2024,
%   author    = {Apellido, Nombre},
%   title     = {Título del libro},
%   year      = {2024},
%   publisher = {Editorial},
%   address   = {Ciudad, País}
% }
%
% @article{apellido2023,
%   author  = {Apellido, Nombre},
%   title   = {Título del artículo},
%   journal = {Nombre de la revista},
%   year    = {2023},
%   volume  = {12},
%   number  = {3},
%   pages   = {45--67},
%   doi     = {10.xxxx/xxxxx}
% }
%
% @online{institucion2025,
%   author  = {{Nombre de la Institución}},
%   title   = {Título del informe o página},
%   year    = {2025},
%   url     = {https://...},
%   urldate = {2026-06-04}
% }
% =============================================================================
